# ╔══════════════════════════════════════════════════════════════╗
# ║           SHADE BACKEND — Ortam Değişkenleri                ║
# ║                                                              ║
# ║  1. Bu dosyayı kopyala: cp .env.example .env                ║
# ║  2. Gerçek değerleri doldur                                  ║
# ║  3. .env asla git'e commit edilmez (.gitignore'da mevcut)    ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Server ──────────────────────────────────────────────────────
APP_PORT=:8080

# ── PostgreSQL ──────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=shade
DB_PASSWORD=CHANGE_ME
DB_NAME=shade_db
DB_PORT=5432
DB_SSL_MODE=disable
DB_TIMEZONE=Europe/Istanbul

# ── JWT ─────────────────────────────────────────────────────────
# Minimum 32 karakter — üretmek için:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_minimum_32_characters_required

# ── RabbitMQ ────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ── Cloudflare R2 (Medya depolama) ──────────────────────────────
# Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_ACCESS_SECRET=CHANGE_ME
R2_BUCKET_NAME=shade-media

# ── Firebase FCM (Push notification) ────────────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate key
# Boş bırakılırsa FCM devre dışı kalır, diğer özellikler çalışır
FIREBASE_CREDENTIALS_PATH=firebase-adminsdk.json
